<%- include("partials/navbar") %>

<div class="container mt-4">
  <h2 class="fw-bold mb-4">Explore All Songs</h2>

  <div class="row">

    <% music.forEach(song => { %>
      <div class="col-md-3">
        <div class="card shadow-sm mb-4">
          <img src="/uploads/<%= song.thumbnail %>" class="card-img-top" style="height:200px; object-fit:cover;">
          <div class="card-body">
            <h6 class="fw-bold"><%= song.title %></h6>
            <p class="text-muted m-0">By <%= song.singer %></p>

            <audio controls class="w-100 mt-2">
              <source src="/uploads/<%= song.audioFile %>">
            </audio>
          </div>
        </div>
      </div>
    <% }) %>

  </div>
</div>

<%- include("partials/footer") %>