<% layout("boilerplate") %>

<div class="container mt-4">

    <h2 class="fw-bold">My Playlists</h2>

    <!-- CREATE PLAYLIST FORM -->
    <form action="/playlist/create" method="POST" class="mt-3">

        <div class="input-group">

            <input type="text"
                   name="name"
                   class="form-control"
                   placeholder="Enter playlist name"
                   required>

            <button class="btn btn-success">
                Create
            </button>

        </div>

    </form>

    <hr>

    <!-- SHOW PLAYLISTS -->
    <div class="row mt-3">

        <% playlists.forEach(p => { %>

            <div class="col-md-4">

                <div class="card shadow-sm mb-3">

                    <div class="card-body">

                        <h5><%= p.name %></h5>

                        <a href="/playlist/<%= p._id %>"
                           class="btn btn-primary mt-2">
                            Open
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>